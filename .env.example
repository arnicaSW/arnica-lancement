# ─── Stockage des inscriptions ────────────────────────────────
# Valeurs possibles : supabase | formspree | mock
#   mock = aucune donnée envoyée, pratique pour développer en local
VITE_STORAGE_PROVIDER=supabase

# Supabase (Project Settings → API)
# URL du projet, ex. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
# Clé publique « anon » ou « publishable » (JAMAIS la clé service_role / secret)
VITE_SUPABASE_ANON_KEY=
# Nom de la table (voir supabase/schema.sql)
VITE_SUPABASE_TABLE=interest_signups
VITE_SUPABASE_SURVEY_TABLE=survey_responses
VITE_SUPABASE_CONTACT_TABLE=survey_contacts
VITE_SUPABASE_PARTNER_TABLE=partner_leads

# Formspree (alternative) : identifiant du formulaire, ex. xyzabcd
VITE_FORMSPREE_ID=

# ─── Couleurs ───────────────────────────────────────────────
# nouvelle  = palette choisie par l'équipe (par défaut)
# originale = première palette proposée
VITE_THEME=nouvelle

# ─── Site ─────────────────────────────────────────────────────
# URL publique du site (utilisée pour les balises Open Graph au build)
VITE_SITE_URL=https://rassusante.netlify.app
